# Normaliza los finales de línea a LF dentro del repositorio.
# En Windows, sin esto, cada archivo aparece como "modificado" al cambiar de rama.
* text=auto eol=lf

*.java   text diff=java
*.html   text diff=html
*.css    text
*.sql    text
*.md     text
*.yml    text
*.yaml   text
*.xml    text
*.properties text

# Binarios: Git no debe intentar convertirlos ni mostrar diffs de texto.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary

# Los scripts de Maven conservan su final de línea de origen.
mvnw      text eol=lf
mvnw.cmd  text eol=crlf
